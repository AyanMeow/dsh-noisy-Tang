{
  "name": "dsh-noisy-tang",
  "version": "0.1.0",
  "description": "堂吉诃德 Agent 预设（边狱公司·LCB 3号罪人，两档：热血档/本吾档）— 极简模式工具面 + 吾之骑士人设 + 跨会话长期记忆「冒险手记」（四区格式：固定记忆永久、冒险记录 80 条 FIFO、最近详细区、卷轴归档）。记忆走提示变量注入（读）+ 共享写入工具 tang_journal_add（写），两档共用同一份手记。人设浓度分档规则（闲聊全人设 / 问答三明治 / 检索点缀 / 技术叙述分离 / 严肃本吾档）写进人设正文并由 verify-persona-rules.mjs 守门；思维链一律简体中文，由 verify-thinking-language.mjs 守门。",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "agent-preset",
    "persona",
    "limbus-company",
    "don-quixote",
    "堂吉诃德"
  ],
  "exports": {
    ".": "./src/index.js",
    "./memory": "./src/memory.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1-rc.0 <4.1.0 || >=4.0.5-0 <5.0.0-0",
    "@deepseek-ai/dsh-agent-preset": ">=0.1.7-0 <0.2.0 || >=0.2.0-rc.1 <0.2.1-0 || >=0.2.1-alpha.0 <0.3.0-0",
    "@deepseek-ai/dsh-agent-preset-registry": ">=0.1.7-0 <0.2.0 || >=0.2.0-rc.1 <0.2.1-0 || >=0.2.1-alpha.0 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent-preset": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent-preset-registry": {
      "optional": true
    }
  },
  "dsh-plugin": {
    "category": "identity",
    "displayName": "堂吉诃德 Agent 预设（热血档 + 本吾档）"
  }
}
